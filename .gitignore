# ---------------------------------------------------------------
# Windows helper binaries
# ---------------------------------------------------------------
# These are 5-222 MB each and ffmpeg.exe/ffprobe.exe exceed GitHub's 100 MB
# per-file hard limit, so pushing them would be rejected. Fetch them with
# tools/fetch_win_helpers.ps1 (which build_windows.ps1 and CI both call).
ffmpeg.exe
ffprobe.exe
ffplay.exe
yt-dlp.exe
aria2c.exe
updater_cli.exe

# ---------------------------------------------------------------
# Build outputs
# ---------------------------------------------------------------
build/
dist/
mysetup*.exe
*.bak

# Local diagnostic scratch: the frozen-runtime probe and any screenshots taken
# while debugging a build. _frozen_probe.py IS tracked on purpose - it is the
# only way to prove the lazy imports and the _internal helper lookup inside a
# real bundle - but these byproducts of running it are not.
_shot.png
_*_build.log
_app_out.txt
_app_err.txt
_probe_build.log
probe_out.txt

# ---------------------------------------------------------------
# Verification-harness byproducts (_cpu_check.py / _e2e_download_check.py).
# The harness scripts themselves are tracked on purpose - they are the only way
# to exercise a real network download and the AE re-encode path - but the log
# files and scratch clips they produce are not.
# ---------------------------------------------------------------
_cpu_out.txt
_cpu_err.txt
_cpu_pid.txt
_e2e_out.txt
_e2e_err.txt
_ae_cpu_check_4k.mp4
_short4k.mp4

# ---------------------------------------------------------------
# Local environments and caches
# ---------------------------------------------------------------
.venv/
.venv-mac/
__pycache__/
*.pyc

# ---------------------------------------------------------------
# Per-user runtime state (machine-specific, regenerated on launch)
# ---------------------------------------------------------------
download_history.json
download_queue.json
ui_prefs.json
.legacy_data_migrated