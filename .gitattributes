# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts MUST keep LF line endings. They are executed by bash on the
# macOS CI runner, and a stray CRLF makes bash fail with:
#   $'\r': command not found
*.sh text eol=lf

# PowerShell build scripts run on Windows (locally and on the CI runner), where
# CRLF is native. Bash scripts must stay LF (above); .ps1 files are the mirror
# image of that rule.
*.ps1 text eol=crlf

# Binary model/weights data - never normalise or diff these.
*.bin binary
